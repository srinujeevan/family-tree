# Used only by `npm test`. Points at a separate database on the same
# Postgres server so tests never touch dev data. See scripts/prepareTestDb.js.
DATABASE_URL="postgresql://family_tree_app:changeme@localhost:5432/family_tree_test?schema=public"

NODE_ENV=test
PORT=3001
CORS_ORIGIN="http://localhost:4200"

JWT_ACCESS_SECRET=test-only-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-only-refresh-secret-0123456789abcdef
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET=test-only-cookie-secret-0123456789abcdef

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads-test
MAX_UPLOAD_SIZE_MB=5

# High limits so a full test run never trips rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=5000

LOG_LEVEL=silent
