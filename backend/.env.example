# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

# --- Database ---------------------------------------------------------
# Matches the docker-compose.yml postgres service at the repo root.
DATABASE_URL="postgresql://family_tree_app:changeme@localhost:5432/family_tree_db?schema=public"

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# --- Auth (JWT) -----------------------------------------------------------
# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-long-random-secret"

# --- File storage -----------------------------------------------------------
# "local" for development, "s3" for production (S3-compatible object storage).
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info
